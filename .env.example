# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# All of these are read on the server only. Do not add a NEXT_PUBLIC_ prefix to any of them.

# AI search (optional). Without these, a simple keyword reader is used instead.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# A production model that supports strict structured outputs, e.g. openai/gpt-oss-20b
# (check https://console.groq.com/docs/models and your account's Limits page).
GROQ_MODEL=

# IGDB (optional): search across every PC game, AI picks outside the catalogue, and
# `npm run sync:igdb` (descriptions and artwork). Without these, name search uses store data only.
# Register an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
